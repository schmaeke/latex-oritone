% This package contains design primitives that are shared by the document
% classes and the Beamer theme. It assumes `oritone` has already installed the
% semantic color roles, then adds reusable spacing constants, font role helpers,
% localized labels, title rules, semantic link setup, and callout environments.

\RequirePackage{oritone}

% Shared measurements. Classes should use these names instead of hard-coded
% rule widths or callout padding so changes remain consistent across CV,
% manuscript, thesis, and Beamer surfaces.
\newlength{\oritonerulewidth}
\newlength{\oritoneaccentbarwidth}
\newlength{\oritoneblockrulewidth}
\newlength{\oritoneblockxsep}
\newlength{\oritoneblockysep}
\newlength{\oritonetitlerulegap}
\newlength{\oritonetitlerulelowercorrection}
\setlength{\oritonerulewidth}{0.25mm}
\setlength{\oritoneaccentbarwidth}{1.4mm}
\setlength{\oritoneblockrulewidth}{0.65mm}
\setlength{\oritoneblockxsep}{2.5mm}
\setlength{\oritoneblockysep}{1.5mm}
\setlength{\oritonetitlerulegap}{2mm}
\setlength{\oritonetitlerulelowercorrection}{2mm}

% Font role switches. `oritone-fonts` chooses the actual families; these helpers
% describe where the classes use body, display, and mono typography.
\newcommand*\oritoneUseSerifAsDefault{%
  \renewcommand*\familydefault{\rmdefault}%
  \normalfont
}
\newcommand*\oritoneUseSansAsDefault{%
  \renewcommand*\familydefault{\sfdefault}%
  \normalfont
}
\newcommand*\oritoneDisplayFont{\sffamily}
\newcommand*\oritoneBodyFont{\rmfamily}
\newcommand*\oritoneMonoFont{\ttfamily}

% Shared ruled title block for thesis and manuscript title pages. The title is
% measured in a box with a fixed phantom height so the gap to the upper/lower
% rules stays stable even when the title contains descenders.
\newsavebox{\oritone@ruledtitlebox}
\newcommand*\oritoneRuledTitle[1]{%
  \par
  \begingroup
    \linespread{1.0}\selectfont
    \setbox\oritone@ruledtitlebox=\vbox{%
      \hsize=\linewidth
      \topskip=0pt
      \centering
      \oritoneDisplayFont\Huge\bfseries\color{headings}%
      \vphantom{Agjp}#1\vphantom{Agjp}\par
    }%
    \vbox{%
      \hsize=\linewidth
      {\color{accent}\hrule width \hsize height \oritoneaccentbarwidth\relax}%
      \vskip \oritonetitlerulegap
      \nointerlineskip
      \box\oritone@ruledtitlebox
      \vskip \dimexpr\oritonetitlerulegap+\oritonetitlerulelowercorrection\relax
      \nointerlineskip
      {\color{accent}\hrule width \hsize height \dimexpr2\oritonerulewidth\relax}%
    }%
  \endgroup
  \par
}

% Small inline separators and page-number text helpers used by multiple
% classes. Color variants preserve the same glyph and spacing.
\newcommand*\oritonesectionseparator{\enspace\textbullet\enspace}
\newcommand*\oritonemutedseparator{\textcolor{text-muted}{\oritonesectionseparator}}
\newcommand*\oritoneaccentseparator{\textcolor{accent}{\oritonesectionseparator}}
\newcommand*\oritonepagenumbertext[3]{#1\ \textbf{#2}\ #3}

% Label registry. Each label has a key and language; aliases point one language
% at another. The lookup falls back to English, then finally the raw key.
\long\def\oritoneDeclareLabel#1#2#3{%
  \@namedef{oritone@label@#1@#2}{#3}%
}
\newcommand*\oritoneAliasLabel[3]{%
  \@namedef{oritone@label@#1@#2}{\csname oritone@label@#1@#3\endcsname}%
}
\newcommand*\oritonelabel[2]{%
  \ifcsname oritone@label@#1@#2\endcsname
    \csname oritone@label@#1@#2\endcsname
  \else
    \ifcsname oritone@label@#1@english\endcsname
      \csname oritone@label@#1@english\endcsname
    \else
      #1%
    \fi
  \fi
}
% Resolve a label against the current babel language when babel is available.
% Only languages used by the document classes are checked here; other language
% labels remain available through explicit \oritonelabel calls.
\newcommand*\oritonecurrentlabel[1]{%
  \@ifundefined{iflanguage}{%
    \oritonelabel{#1}{english}%
  }{%
    \iflanguage{ngerman}{%
      \oritonelabel{#1}{ngerman}%
    }{%
      \iflanguage{german}{%
        \oritonelabel{#1}{german}%
      }{%
        \oritonelabel{#1}{english}%
      }%
    }%
  }%
}

