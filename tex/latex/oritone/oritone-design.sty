% Apply the active foreground/background colors to the page. Classes call this
% after loading `oritone` so every mode, including black and dark, colors both
% text and page background.
\newcommand*\oritoneApplyPageColors{%
  \color{foreground}%
  \pagecolor{background}%
}
% Configure hyperref to use semantic link colors. The explicit guard keeps the
% error understandable if a class or user calls this before loading hyperref.
\newcommand*\oritoneSetSemanticLinks{%
  \@ifpackageloaded{hyperref}{%
    \hypersetup{%
      colorlinks=true,
      linkcolor=linkcolor,
      citecolor=success,
      urlcolor=linkcolor,
      filecolor=linkcolor,
      pdfborder={0 0 0}%
    }%
  }{%
    \PackageError{oritone-design}{hyperref is not loaded}{%
      Load hyperref before calling \string\oritoneSetSemanticLinks.%
    }%
  }%
}

% Callout support. The flag makes \oritonedefinecallouts safe to call from
% multiple classes or packages in the same document.
\newif\iforitone@calloutsdefined
% Optional callout title renderer. Empty titles intentionally produce no vertical
% title block so untitled callouts stay compact.
\newcommand*\oritone@callouttitle[2]{%
  \def\oritone@callouttitlevalue{#2}%
  \ifx\oritone@callouttitlevalue\@empty
  \else
    {\oritoneDisplayFont\bfseries\color{#1}#2\par}%
    \vspace{0.6mm}%
  \fi
}
% Define three tcolorbox-based semantic callouts: note/accent, example/success,
% and warning/danger. The environments are only installed after tcolorbox is
% loaded, because loading that dependency is a class-level decision.
\newcommand*\oritonedefinecallouts{%
  \iforitone@calloutsdefined
  \else
    \@ifpackageloaded{tcolorbox}{%
      \newenvironment{oritonenote}[1][]{%
        \begin{tcolorbox}[
          enhanced,
          frame hidden,
          sharp corners,
          boxrule=0pt,
          colback=accent!12!background,
          coltext=foreground,
          borderline west={\oritoneblockrulewidth}{0mm}{accent-dark},
          left=\oritoneblockxsep,
          right=\oritoneblockxsep,
          top=\oritoneblockysep,
          bottom=\oritoneblockysep,
          boxsep=0mm
        ]%
        \oritone@callouttitle{accent-dark}{##1}%
      }{%
        \end{tcolorbox}%
      }%
      \newenvironment{oritoneexample}[1][]{%
        \begin{tcolorbox}[
          enhanced,
          frame hidden,
          sharp corners,
          boxrule=0pt,
          colback=success!12!background,
          coltext=foreground,
          borderline west={\oritoneblockrulewidth}{0mm}{darkgreen},
          left=\oritoneblockxsep,
          right=\oritoneblockxsep,
          top=\oritoneblockysep,
          bottom=\oritoneblockysep,
          boxsep=0mm
        ]%
        \oritone@callouttitle{darkgreen}{##1}%
      }{%
        \end{tcolorbox}%
      }%
      \newenvironment{oritonewarning}[1][]{%
        \begin{tcolorbox}[
          enhanced,
          frame hidden,
          sharp corners,
          boxrule=0pt,
          colback=danger!12!background,
          coltext=foreground,
          borderline west={\oritoneblockrulewidth}{0mm}{darkred},
          left=\oritoneblockxsep,
          right=\oritoneblockxsep,
          top=\oritoneblockysep,
          bottom=\oritoneblockysep,
          boxsep=0mm
        ]%
        \oritone@callouttitle{darkred}{##1}%
      }{%
        \end{tcolorbox}%
      }%
      \global\oritone@calloutsdefinedtrue
    }{%
      \PackageError{oritone-design}{tcolorbox is not loaded}{%
        Load tcolorbox before calling \string\oritonedefinecallouts.%
      }%
    }%
  \fi
}

