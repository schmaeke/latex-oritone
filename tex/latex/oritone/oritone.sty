  \colorlet{verylightred}{red!18!background}%
  \colorlet{lightred}{red!45!background}%
  \colorlet{darkred}{red!70!foreground}%
  \colorlet{verydarkred}{red!86!foreground}%
  \colorlet{verylightyellow}{yellow!18!background}%
  \colorlet{lightyellow}{yellow!45!background}%
  \colorlet{darkyellow}{yellow!70!foreground}%
  \colorlet{verydarkyellow}{yellow!86!foreground}%
  \colorlet{verylightorange}{orange!18!background}%
  \colorlet{lightorange}{orange!45!background}%
  \colorlet{darkorange}{orange!70!foreground}%
  \colorlet{verydarkorange}{orange!86!foreground}%
  \colorlet{verylightgreen}{green!18!background}%
  \colorlet{lightgreen}{green!45!background}%
  \colorlet{darkgreen}{green!70!foreground}%
  \colorlet{verydarkgreen}{green!86!foreground}%
  \colorlet{verylightblue}{blue!18!background}%
  \colorlet{lightblue}{blue!45!background}%
  \colorlet{darkblue}{blue!70!foreground}%
  \colorlet{verydarkblue}{blue!86!foreground}%
  \colorlet{verylightpurple}{purple!18!background}%
  \colorlet{lightpurple}{purple!45!background}%
  \colorlet{darkpurple}{purple!70!foreground}%
  \colorlet{verydarkpurple}{purple!86!foreground}%
  \colorlet{verylightcyan}{cyan!18!background}%
  \colorlet{lightcyan}{cyan!45!background}%
  \colorlet{darkcyan}{cyan!70!foreground}%
  \colorlet{verydarkcyan}{cyan!86!foreground}%
  \colorlet{lightgray}{foreground!15!background}%
  \colorlet{gray}{foreground!45!background}%
  \colorlet{darkgray}{foreground!70!background}%
}

% Functional roles are the class-facing API. They translate the active palette
% into stable names used by classes, listings, plots, captions, links, and
% headers/footers.
\newcommand*\oritone@setfunctionalroles{%
  \colorlet{body}{surface}%
  \colorlet{headings}{text-strong}%
  \colorlet{headerandfooter}{text-muted}%
  \colorlet{accent}{primary}%
  \colorlet{accent-hover}{primary-hover}%
  \colorlet{linkcolor}{primary}%
  \colorlet{listingkeyword}{secondary}%
  \colorlet{listingtype}{primary}%
  \colorlet{listingfunction}{info}%
  \colorlet{listingcomment}{success}%
  \colorlet{listingstring}{orange}%
  \colorlet{listingemphasis}{warning}%
  \colorlet{listingrule}{border}%
  \colorlet{listingbackground}{surface}%
  % Qualitative plot colors track the Okabe-Ito colorblind-safe palette using the
  % closest Oritone hue for each entry: blue, vermillion, bluish green, reddish
  % purple, sky blue, orange, and yellow. `plotskyblue` and `plotgold` are kept
  % as aliases for older documents.
  \colorlet{plotblue}{blue}%
  \colorlet{plotvermillion}{vermillion}%
  \colorlet{plotgreen}{green}%
  \colorlet{plotpurple}{purple}%
  \colorlet{plotsky}{sky}%
  \colorlet{plotorange}{orange}%
  \colorlet{plotyellow}{yellow}%
  \colorlet{plotgray}{text-muted}%
  \colorlet{plotskyblue}{sky}%
  \colorlet{plotgold}{amber}%
}

% Accent shade lets a document deepen or soften the main accent without changing
% the selected hue. Each name expands to a color-expression suffix appended to
% the base hue: `dark`/`darker` blend it toward the foreground text color (useful
% when the default accent looks too bright on the light and white modes), while
% `light`/`lighter` blend it toward the page background. `normal` (the default)
% and `default` leave the hue untouched.
\def\oritone@accentshade@normal{}
\def\oritone@accentshade@default{}
\def\oritone@accentshade@dark{!80!foreground}
\def\oritone@accentshade@darker{!62!foreground}
\def\oritone@accentshade@light{!80!background}
\def\oritone@accentshade@lighter{!62!background}
% Store the requested shade. Validation is delayed until the accent is applied,
% mirroring how the accent hue itself is resolved.
\newcommand*\oritone@selectaccentshade[1]{%
  \edef\oritone@accentshade{#1}%
}

% Accent colors are computed from one base hue. The requested accent shade is
% applied to that hue first, then the hover, link, and light/dark ramp variants
% are all derived from the shaded accent. This keeps the whole accent family --
% title rules, callout borders, links, Beamer progress bars, headings, and the
% footer bar -- shifting together so a shaded accent stays consistent in every
% mode.
\newcommand*\oritone@setaccentcolors[1]{%
  \@ifundefined{oritone@accentshade@\oritone@accentshade}{%
    \PackageWarning{oritone}{Unknown accentshade '\oritone@accentshade'. Using 'normal'}%
    \def\oritone@accentshade{normal}%
  }{}%
  \edef\oritone@accentexpr{#1\csname oritone@accentshade@\oritone@accentshade\endcsname}%
  \colorlet{accent}{\oritone@accentexpr}%
  \colorlet{accent-hover}{accent!86!foreground}%
  \colorlet{accent-verylight}{accent!18!background}%
  \colorlet{accent-light}{accent!46!background}%
  \colorlet{accent-dark}{accent!70!foreground}%
  \colorlet{accent-verydark}{accent!86!foreground}%
  \colorlet{linkcolor}{accent}%
}
% User-facing accent names are aliases because some design terms changed over
% time. `purple` intentionally maps to the rose hue to keep older documents
% compiling with the current palette.
\newcommand*\oritone@defineaccentalias[2]{\@namedef{oritone@accent@#1}{#2}}
\oritone@defineaccentalias{orange}{orange}
\oritone@defineaccentalias{sky}{sky}
\oritone@defineaccentalias{green}{green}
\oritone@defineaccentalias{yellow}{yellow}
\oritone@defineaccentalias{blue}{blue}
\oritone@defineaccentalias{vermillion}{vermillion}
\oritone@defineaccentalias{rose}{rose}
\oritone@defineaccentalias{purple}{rose}
\oritone@defineaccentalias{red}{red}
\oritone@defineaccentalias{amber}{amber}
\oritone@defineaccentalias{cyan}{cyan}
\oritone@defineaccentalias{primary}{primary}
\oritone@defineaccentalias{secondary}{secondary}
\oritone@defineaccentalias{success}{success}
\oritone@defineaccentalias{warning}{warning}
\oritone@defineaccentalias{danger}{danger}
\oritone@defineaccentalias{info}{info}
\def\oritone@accent@auto{auto}
\def\oritone@defaultaccent{blue}
% Store the requested accent. Validation is delayed until mode application so
% the default accent can be resolved consistently from package options and from
% later \oritonesetup calls.
\newcommand*\oritone@selectaccent[1]{%
  \edef\oritone@accent{#1}%
}
% Validate the requested accent and derive all accent-* semantic aliases.
\newcommand*\oritone@applyaccent{%
  \edef\oritone@requestedaccent{\oritone@accent}%
  \ifx\oritone@requestedaccent\oritone@accent@auto
    \edef\oritone@requestedaccent{\oritone@defaultaccent}%
  \fi
  \@ifundefined{oritone@accent@\oritone@requestedaccent}{%
    \PackageWarning{oritone}{Unknown accent '\oritone@requestedaccent'. Using '\oritone@defaultaccent'}%
    \edef\oritone@requestedaccent{\oritone@defaultaccent}%
  }{}%
  \edef\oritone@accentcolor{\@nameuse{oritone@accent@\oritone@requestedaccent}}%
  \expandafter\oritone@setaccentcolors\expandafter{\oritone@accentcolor}%
}

