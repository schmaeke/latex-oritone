% for accents and semantic colors. This is useful for print-oriented examples.
\newcommand*\oritonewhitecolors{%
  \definecolor{foreground}{HTML}{000000}%
  \definecolor{background}{HTML}{ffffff}%
  \colorlet{background-lower}{background}%
  \colorlet{surface}{foreground!3!background}%
  \colorlet{surface-raised}{foreground!6!background}%
  \colorlet{surface-highest}{foreground!10!background}%
  \colorlet{border}{foreground!18!background}%
  \colorlet{divider}{foreground!14!background}%
  \colorlet{text-strong}{foreground}%
  \colorlet{text}{foreground!88!background}%
  \colorlet{text-subtle}{foreground!68!background}%
  \colorlet{text-muted}{foreground!52!background}%
  \colorlet{text-disabled}{foreground!38!background}%
  \colorlet{selection}{foreground!10!background}%
  \colorlet{selection-strong}{foreground!16!background}%
  \colorlet{highlight}{foreground!5!background}%
  \colorlet{focus-ring}{oritone-light-primary}%
  \colorlet{cursor}{oritone-light-primary}%
  \colorlet{cursor-text}{background}%
  \oritone@setlightfamily
  \oritone@derivefamilies
  \oritone@setfunctionalroles
}

% `black` keeps the page purely black/white while reusing the dark hue family.
\newcommand*\oritoneblackcolors{%
  \definecolor{foreground}{HTML}{ffffff}%
  \definecolor{background}{HTML}{000000}%
  \colorlet{background-lower}{background}%
  \colorlet{surface}{foreground!7!background}%
  \colorlet{surface-raised}{foreground!11!background}%
  \colorlet{surface-highest}{foreground!16!background}%
  \colorlet{border}{foreground!24!background}%
  \colorlet{divider}{foreground!20!background}%
  \colorlet{text-strong}{foreground}%
  \colorlet{text}{foreground!88!background}%
  \colorlet{text-subtle}{foreground!70!background}%
  \colorlet{text-muted}{foreground!55!background}%
  \colorlet{text-disabled}{foreground!40!background}%
  \colorlet{selection}{foreground!14!background}%
  \colorlet{selection-strong}{foreground!22!background}%
  \colorlet{highlight}{foreground!10!background}%
  \colorlet{focus-ring}{oritone-dark-warning}%
  \colorlet{cursor}{oritone-dark-warning}%
  \colorlet{cursor-text}{background}%
  \oritone@setdarkfamily
  \oritone@derivefamilies
  \oritone@setfunctionalroles
}

% Apply the selected mode in two passes: first validate the mode and install
% the color family, then derive the accent aliases from that active family.
\newcommand*\oritone@applymode{%
  \oritone@selectmode{\oritone@mode}%
  \csname oritone\oritone@mode colors\endcsname
  \oritone@applyaccent
}

% listings integration. The setup is idempotent so classes can call
% \oritonelistingssetup unconditionally after loading listings. The base style
% keeps the listing font small but inherits the document line spacing.
\newif\iforitone@listingssetup
\newcommand*\oritone@listingssetup{%
  \iforitone@listingssetup
  \else
    \oritone@listingssetuptrue
    \lstdefinelanguage{Julia}%
      {morekeywords={abstract,begin,break,case,catch,const,continue,do,else,elseif,%
          end,export,false,for,function,if,import,importall,in,let,macro,module,%
          mutable,primitive,quote,return,struct,true,try,type,using,where,while},%
       morekeywords=[2]{AbstractArray,Array,Bool,Dict,Float64,Function,Int,Matrix,%
          NamedTuple,Nothing,Real,String,Symbol,Tuple,Vector},%
       morekeywords=[3]{abs,copy,eachindex,error,fill!,length,map,maximum,norm,%
          ones,print,println,push!,range,similar,sqrt,sum,zeros},%
       sensitive=true,%
       alsoletter={!},%
       alsoother={$},%
       morecomment=[l]\#,%
       morecomment=[n]{\#=}{=\#},%
       morestring=[s]{"}{"},%
       morestring=[m]{'}{'},%
      }[keywords,comments,strings]%
    \lstdefinestyle{oritone-listing}{%
      frame=single,
      framerule=0.25mm,
      framesep=1.5mm,
      rulecolor=\color{listingrule},
      belowcaptionskip=2mm,
      aboveskip=0.75\baselineskip,
      belowskip=0.75\baselineskip,
      showstringspaces=false,
      columns=fullflexible,
      keepspaces=true,
      basicstyle={\ttfamily\footnotesize\color{foreground}},
      numbers=left,
      numbersep=6pt,
      numberstyle={\color{text-muted}\ttfamily\scriptsize},
      xleftmargin=12pt,
      xrightmargin=0pt,
      keywordstyle={\color{listingkeyword}},
      keywordstyle=[2]{\color{listingtype}},
      keywordstyle=[3]{\color{listingfunction}},
      commentstyle={\color{listingcomment}\itshape},
      stringstyle={\color{listingstring}},
      breaklines=true,
      breakatwhitespace=true,
      tabsize=2,
      backgroundcolor=\color{listingbackground},
      mathescape=true,
      captionpos=b,
      emphstyle={\color{listingemphasis}},
      escapechar=?,
      upquote=true,
    }%
    % Aliases kept for document classes and older examples. They currently
    % point at the same framed style, while `oritone-listing-algorithm` selects
    % Julia syntax highlighting.
    \lstdefinestyle{oritone-julia}{%
      style=oritone-listing,
      language=Julia,
    }%
    \lstdefinestyle{oritone-listing-numbered}{%
      style=oritone-listing,
    }%
    \lstdefinestyle{oritone-listing-code}{%
      style=oritone-listing,
    }%
    \lstdefinestyle{oritone-listing-algorithm}{%
      style=oritone-julia,
    }%
  \fi
}

% Public guard around the private setup routine. It gives a clear error if the
% caller forgot to load listings or use the `listings` package option.
\newcommand*\oritonelistingssetup{%
  \@ifpackageloaded{listings}{%
    \oritone@listingssetup
  }{%
    \PackageError{oritone}{listings is not loaded}{%
      Load listings before \string\oritonelistingssetup\space or use
      \string\usepackage[listings]{oritone}.%
    }%
  }%
}

% Hook support lets users load listings before or after oritone. Older LaTeX
% kernels fall back to an AtBeginDocument check.
\@ifpackageloaded{listings}{\oritone@listingssetup}{}
\@ifundefined{AddToHook}{%
  \AtBeginDocument{\@ifpackageloaded{listings}{\oritone@listingssetup}{}}%
}{%
  \AddToHook{package/listings/after}{\oritone@listingssetup}%
}

% pgfplots integration. The setup installs cycle lists and a scientific
% colormap using Oritone semantic plot colors. It is idempotent so classes may
% call it safely.
\newif\iforitone@pgfplotssetup
\newcommand*\oritone@pgfplotssetup{%
  \iforitone@pgfplotssetup
  \else
    \oritone@pgfplotssetuptrue
    \pgfplotscreateplotcyclelist{oritone markers}{%
      {plotblue, line width=0.9pt, mark=*, mark size=2.2pt,
        mark options={solid, draw=plotblue!55!black, fill=plotblue, line width=0.35pt}}\\%
      {plotvermillion, line width=0.9pt, mark=square*, mark size=2.2pt,
        mark options={solid, draw=plotvermillion!55!black, fill=plotvermillion, line width=0.35pt}}\\%
      {plotgreen, line width=0.9pt, mark=triangle*, mark size=2.3pt,
        mark options={solid, draw=plotgreen!55!black, fill=plotgreen, line width=0.35pt}}\\%
      {plotpurple, line width=0.9pt, mark=diamond*, mark size=2.4pt,
        mark options={solid, draw=plotpurple!55!black, fill=plotpurple, line width=0.35pt}}\\%
      {plotsky, line width=0.9pt, mark=pentagon*, mark size=2.3pt,
        mark options={solid, draw=plotsky!55!black, fill=plotsky, line width=0.35pt}}\\%
      {plotorange, line width=0.9pt, mark=*, mark size=2.2pt,
        mark options={solid, draw=plotorange!55!black, fill=plotorange, line width=0.35pt}}\\%
      {plotyellow, line width=0.9pt, mark=square*, mark size=2.2pt,
        mark options={solid, draw=plotyellow!55!black, fill=plotyellow, line width=0.35pt}}\\%
      {plotgray, line width=0.9pt, mark=triangle*, mark size=2.3pt,
        mark options={solid, draw=plotgray!55!black, fill=plotgray, line width=0.35pt}}\\%
    }%
    \pgfplotscreateplotcyclelist{oritone no markers}{%
      {plotblue, line width=0.9pt, mark=none}\\%
      {plotvermillion, line width=0.9pt, mark=none}\\%
      {plotgreen, line width=0.9pt, mark=none}\\%
      {plotpurple, line width=0.9pt, mark=none}\\%
      {plotsky, line width=0.9pt, mark=none}\\%
      {plotorange, line width=0.9pt, mark=none}\\%
      {plotyellow, line width=0.9pt, mark=none}\\%
      {plotgray, line width=0.9pt, mark=none}\\%
    }%
    \pgfplotsset{
      colormap={oritone scientific}{%
        rgb255=(0, 36, 57)
        rgb255=(0, 105, 156)
        rgb255=(31, 117, 154)
        rgb255=(8, 123, 124)
        rgb255=(0, 122, 90)
        rgb255=(126, 102, 0)
        rgb255=(149, 87, 0)
        rgb255=(178, 70, 0)
        rgb255=(167, 75, 66)
      },
      oritone markers/.style={cycle list name=oritone markers},
      oritone no markers/.style={cycle list name=oritone no markers},
      plot markers/.style={cycle list name=oritone markers},
      plot no markers/.style={cycle list name=oritone no markers},
      oritone markers,
      colormap name=oritone scientific,
    }%
  \fi
}

% Public guard around pgfplots setup, matching the listings guard above.
\newcommand*\oritonepgfplotssetup{%
  \@ifpackageloaded{pgfplots}{%
    \oritone@pgfplotssetup
  }{%
    \PackageError{oritone}{pgfplots is not loaded}{%
      Load pgfplots before \string\oritonepgfplotssetup\space or use
      \string\usepackage[plots]{oritone}.%
    }%
  }%
}

% As with listings, support both load orders for pgfplots.
\@ifpackageloaded{pgfplots}{\oritone@pgfplotssetup}{}
\@ifundefined{AddToHook}{%
  \AtBeginDocument{\@ifpackageloaded{pgfplots}{\oritone@pgfplotssetup}{}}%
}{%
  \AddToHook{package/pgfplots/after}{\oritone@pgfplotssetup}%
}

% Install the initial semantic color roles as the final package action.
\oritone@applymode
\endinput
