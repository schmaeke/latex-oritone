\ProvidesPackage{oritone}[2026/05/04 v0.1.0 Oritone color roles for LaTeX]

% This package is the color and visualization foundation for all Oritone
% classes and themes. It exposes semantic color names such as `foreground`,
% `background`, `accent`, `linkcolor`, and `listingkeyword` so document classes
% can talk about intent instead of specific hex values.
%
% Public entry points:
%   \usepackage[mode=...,accent=...]{oritone}
%   \oritonesetup{mode=...,accent=...}
%   \oritonelistingssetup
%   \oritonepgfplotssetup
%
% The package is split into these regions:
%   1. Option parsing and runtime setup.
%   2. Base palette data for light and dark color families.
%   3. Semantic aliases, accent handling, and mode application.
%   4. Optional listings and pgfplots integration.

% Option handling. The `mode` option picks a background/foreground family,
% `accent` picks the document accent, and `listings`/`plots` opt into loading
% the optional integration packages from here. Unknown options are forwarded to
% xcolor so package users can still pass standard color options.
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=oritone,prefix=oritone@}
\DeclareStringOption[light]{mode}
\DeclareStringOption[auto]{accent}
\DeclareStringOption[normal]{accentshade}
\DeclareBoolOption{listings}
\DeclareBoolOption{plots}
\DeclareVoidOption{light}{\def\oritone@mode{light}}
\DeclareVoidOption{dark}{\def\oritone@mode{dark}}
\DeclareVoidOption{white}{\def\oritone@mode{white}}
\DeclareVoidOption{black}{\def\oritone@mode{black}}
\DeclareVoidOption{julia}{\oritone@listingstrue}
\DeclareVoidOption{pgfplots}{\oritone@plotstrue}
\DeclareDefaultOption{\PassOptionsToPackage{\CurrentOption}{xcolor}}
\ProcessKeyvalOptions*

\RequirePackage{xcolor}
\RequirePackage{keyval}

\iforitone@listings
  \RequirePackage{listings}
\fi

\iforitone@plots
  \RequirePackage{pgfplots}
\fi

% Runtime configuration mirrors the package options. Calling \oritonesetup
% after package load recomputes the semantic aliases so later pages, listings,
% links, and plots see the updated roles.
\define@key{oritone}{mode}{\oritone@selectmode{#1}}
\define@key{oritone}{accent}{\oritone@selectaccent{#1}}
\define@key{oritone}{accentshade}{\oritone@selectaccentshade{#1}}
\newcommand*\oritonesetup[1]{%
  \setkeys{oritone}{#1}%
  \oritone@applymode
}

\def\oritone@mode@light{light}
\def\oritone@mode@dark{dark}
\def\oritone@mode@white{white}
\def\oritone@mode@black{black}

\newcommand*\oritone@selectmode[1]{%
  \edef\oritone@requestedmode{#1}%
  \@ifundefined{oritone@mode@\oritone@requestedmode}{%
    \PackageWarning{oritone}{Unknown mode '\oritone@requestedmode'. Using 'light'}%
    \def\oritone@mode{light}%
  }{%
    \edef\oritone@mode{\oritone@requestedmode}%
  }%
}

