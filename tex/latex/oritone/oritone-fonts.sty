\NeedsTeXFormat{LaTeX2e}[2020-10-01]
\ProvidesPackage{oritone-fonts}[2026/05/04 v0.1.0 Font roles for Oritone documents]

% This package centralizes font selection for all Oritone classes and themes.
% It keeps the class files free from engine-specific font loading details.
%
% The default profile is:
%   serif: STIX Two Text
%   math:  STIX Two Math
%   sans:  Roboto Condensed
%   mono:  Recursive Mono
%
% pdfLaTeX cannot load system OpenType fonts directly, so Roboto Condensed is
% provided through the `roboto` package and Recursive Mono through the optional
% external `recursive` package. If either support package is missing, the code
% falls back to PTSans and Inconsolata and emits package warnings. LuaLaTeX and
% XeLaTeX use fontspec/unicode-math and try several installed font names and
% file names before falling back.

\RequirePackage{iftex}
\RequirePackage{kvoptions}

% User-facing options. Classes usually use the defaults, but documents can pass
% through custom family names and scale factors when they load oritone-fonts
% directly.
\SetupKeyvalOptions{family=oritonefonts,prefix=oritonefonts@}
\DeclareStringOption[STIX Two Text]{serif}
\DeclareStringOption[STIX Two Math]{math}
\DeclareStringOption[Roboto Condensed]{sans}
\DeclareStringOption[Recursive Mono]{mono}
\DeclareStringOption[0.95]{sansscale}
\DeclareStringOption[1.0]{monoscale}
\ProcessKeyvalOptions*

% Public accessors let diagnostics or downstream code inspect the selected font
% names without knowing the kvoptions-generated internal macro names.
\newcommand*\oritoneseriffontname{\oritonefonts@serif}
\newcommand*\oritonemathfontname{\oritonefonts@math}
\newcommand*\oritonesansfontname{\oritonefonts@sans}
\newcommand*\oritonemonofontname{\oritonefonts@mono}

% Keep warnings consistent across all fallback branches.
\newcommand*\oritone@fontwarning[2]{%
  \PackageWarning{oritone-fonts}{#1 not found. Using #2}%
}

% The bundled defaults get special handling because their public font names
% differ across pdfLaTeX support packages, system font installations, and static
% OpenType file distributions.
\def\oritone@recursive@sans{Recursive Sans}
\def\oritone@recursive@mono{Recursive Mono}
\def\oritone@roboto@sans{Roboto Condensed}

\newif\iforitone@recursivesans
\newif\iforitone@recursivemono
\newif\iforitone@robotosans
\newif\iforitone@fontselected

% Flag which bundled default the requested sans/mono names match. The flags let
% the pdfLaTeX and fontspec branches pick the right support package (roboto or
% recursive) and skip that probing entirely when a user supplied a different
% font family.
\newcommand*\oritone@setfontflags{%
  \oritone@recursivesansfalse
  \oritone@recursivemonofalse
  \oritone@robotosansfalse
  \edef\oritone@requestedfont{\oritonefonts@sans}%
  \ifx\oritone@requestedfont\oritone@recursive@sans
    \oritone@recursivesanstrue
  \fi
  \ifx\oritone@requestedfont\oritone@roboto@sans
    \oritone@robotosanstrue
  \fi
  \edef\oritone@requestedfont{\oritonefonts@mono}%
  \ifx\oritone@requestedfont\oritone@recursive@mono
    \oritone@recursivemonotrue
  \fi
}

% pdfLaTeX fallback packages. These are only loaded when Recursive is not
% available or when the user selected a non-Recursive family under pdfLaTeX.
\newcommand*\oritone@usepdfsansfallback{%
  \RequirePackage[scaled=\oritonefonts@sansscale]{PTSans}%
}

\newcommand*\oritone@usepdfmonofallback{%
  \RequirePackage[scaled=\oritonefonts@monoscale,mono]{inconsolata}%
}

% pdfLaTeX Roboto Condensed. Under pdfLaTeX the roboto package exposes the
% condensed cut not as a separate family but as font series `c' (medium) and
% `bc' (bold) within its Roboto sans family. Its `condensed' option would make
% that the document-wide default series, which does not survive every way a
% class reaches the sans font (article classes go through \sffamily, but beamer
% makes \sfdefault the document family and typesets the body through
% \seriesdefault) and repoints the fontaxes series axis so the default family is
% probed at the undefined condensed series. So we load roboto WITHOUT that
% option and instead synthesise a family, RobotoLFCond, whose medium/bold
% weights alias the condensed shapes -- which the roboto font definitions
% provide regardless of the option -- and point \sfdefault at it. Roboto
% Condensed then becomes the intrinsic default of the sans family and renders
% whether a class uses \sffamily, \normalfont, or \sfdefault as the document
% family, while the STIX serif body and \seriesdefault stay medium.
\newcommand*\oritone@robotobase{}
% Alias the roboto source series #3 (c or bc) into RobotoLFCond under target
% series #2 (m, b, bx) in encoding #1, for the upright/italic/slanted shapes
% that both the T1 and TS1 condensed cuts provide.
\newcommand*\oritone@condsanssub[3]{%
  \DeclareFontShape{#1}{RobotoLFCond}{#2}{n}{<->ssub*\oritone@robotobase/#3/n}{}%
  \DeclareFontShape{#1}{RobotoLFCond}{#2}{it}{<->ssub*\oritone@robotobase/#3/it}{}%
  \DeclareFontShape{#1}{RobotoLFCond}{#2}{sl}{<->ssub*\oritone@robotobase/#3/sl}{}%
}
% Small-caps shapes exist only in the T1 text encoding.
\newcommand*\oritone@condsanssc[2]{%
  \DeclareFontShape{T1}{RobotoLFCond}{#1}{sc}{<->ssub*\oritone@robotobase/#2/sc}{}%
  \DeclareFontShape{T1}{RobotoLFCond}{#1}{scit}{<->ssub*\oritone@robotobase/#2/scit}{}%
  \DeclareFontShape{T1}{RobotoLFCond}{#1}{scsl}{<->ssub*\oritone@robotobase/#2/scsl}{}%
}
\newcommand*\oritone@usepdfrobotosans{%
  \RequirePackage[scaled=\oritonefonts@sansscale]{roboto}%
  \edef\oritone@robotobase{\sfdefault}%
  \DeclareFontFamily{T1}{RobotoLFCond}{}%
  \DeclareFontFamily{TS1}{RobotoLFCond}{}%
  \oritone@condsanssub{T1}{m}{c}\oritone@condsanssc{m}{c}%
  \oritone@condsanssub{T1}{b}{bc}\oritone@condsanssc{b}{bc}%
  \oritone@condsanssub{T1}{bx}{bc}\oritone@condsanssc{bx}{bc}%
  \oritone@condsanssub{TS1}{m}{c}%
  \oritone@condsanssub{TS1}{b}{bc}%
  \oritone@condsanssub{TS1}{bx}{bc}%
  \renewcommand*\sfdefault{RobotoLFCond}%
  \def\mdseries@sf{m}%
  \def\bfseries@sf{b}%
  \def\seriesdefault{\mddefault}%
}

% The pdfLaTeX Recursive package exposes scale macros. Set them after loading
% the package so the Oritone sans/mono scale options still apply.
\newcommand*\oritone@setrecursivepdfscales{%
  \expandafter\let\csname RecursiveSansLinearStatic@scale\endcsname\oritonefonts@sansscale
  \expandafter\let\csname RecursiveSansCasualStatic@scale\endcsname\oritonefonts@sansscale
  \expandafter\let\csname RecursiveMonoLinearStatic@scale\endcsname\oritonefonts@monoscale
  \expandafter\let\csname RecursiveMonoCasualStatic@scale\endcsname\oritonefonts@monoscale
}

% Load the pdfLaTeX Recursive package only once. Options select linear static
% sans/mono families and the local font map supplied by the external package.
\newcommand*\oritone@loadrecursivepdf[1]{%
  \@ifpackageloaded{recursive}{}{%
    \RequirePackage[#1]{recursive}%
  }%
  \oritone@setrecursivepdfscales
}

% fontspec helper: try a named sans family only if no previous probe succeeded.
\newcommand*\oritone@trysetsansfont[1]{%
  \iforitone@fontselected\else
    \IfFontExistsTF{#1}{%
      \setsansfont{#1}[Scale=\oritonefonts@sansscale]%
      \oritone@fontselectedtrue
    }{}%
  \fi
}

% fontspec helper: try a named mono family only if no previous probe succeeded.
\newcommand*\oritone@trysetmonofont[1]{%
  \iforitone@fontselected\else
    \IfFontExistsTF{#1}{%
      \setmonofont{#1}[Scale=\oritonefonts@monoscale]%
      \oritone@fontselectedtrue
    }{}%
  \fi
}

% fontspec helper: try a static font file family such as RecursiveSansLnrSt.otf
% or RecursiveSansLnrSt.ttf, using the standard regular/italic/bold suffixes.
\newcommand*\oritone@trysetsansfontfiles[2]{%
  \iforitone@fontselected\else
    \IfFontExistsTF{#1-Regular#2}{%
      \setsansfont{#1}[
        Extension=#2,
        UprightFont=*-Regular,
        ItalicFont=*-Italic,
        BoldFont=*-Bold,
        BoldItalicFont=*-BoldItalic,
        Scale=\oritonefonts@sansscale
      ]%
      \oritone@fontselectedtrue
    }{}%
  \fi
}

% Same static-file probe as above, but for the mono family.
\newcommand*\oritone@trysetmonofontfiles[2]{%
  \iforitone@fontselected\else
    \IfFontExistsTF{#1-Regular#2}{%
      \setmonofont{#1}[
        Extension=#2,
        UprightFont=*-Regular,
        ItalicFont=*-Italic,
        BoldFont=*-Bold,
        BoldItalicFont=*-BoldItalic,
        Scale=\oritonefonts@monoscale
      ]%
      \oritone@fontselectedtrue
    }{}%
  \fi
}

\ifPDFTeX
  % pdfLaTeX branch. STIX2 is available as a Type 1 package and becomes the
  % serif family. The sans and mono roles are selected independently: Roboto
  % Condensed loads through the roboto package, Recursive through the optional
  % recursive package, and each role falls back to a widely available Type 1
  % font (PTSans or Inconsolata) when its support package is missing.
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{stix2}
  \oritone@setfontflags
  % recursive.sty can serve both the sans and mono roles, so require it once
  % with a combined option list covering whichever roles still request the
  % Recursive defaults.
  \iforitone@recursivesans
    \iforitone@recursivemono
      \def\oritone@recursivepdfopts{localmap,tabular,sans=linear,mono=linear}%
    \else
      \def\oritone@recursivepdfopts{localmap,tabular,sans=linear,nomono}%
    \fi
  \else
    \iforitone@recursivemono
      \def\oritone@recursivepdfopts{localmap,tabular,nosans,mono=linear}%
    \else
      \let\oritone@recursivepdfopts\relax
    \fi
  \fi
  \ifx\oritone@recursivepdfopts\relax\else
    \IfFileExists{recursive.sty}{%
      \expandafter\oritone@loadrecursivepdf\expandafter{\oritone@recursivepdfopts}%
    }{%
      % recursive.sty missing: clear the Recursive requests so the role code
      % below installs the Type 1 fallbacks and warns once per affected role.
      \iforitone@recursivesans
        \oritone@fontwarning{recursive.sty}{PTSans}%
        \oritone@recursivesansfalse
      \fi
      \iforitone@recursivemono
        \oritone@fontwarning{recursive.sty}{Inconsolata}%
        \oritone@recursivemonofalse
      \fi
    }%
  \fi
  % Sans role: Roboto Condensed via the roboto package, Recursive via the load
  % above, or PTSans as the universal Type 1 fallback.
  \iforitone@robotosans
    \IfFileExists{roboto.sty}{%
      \oritone@usepdfrobotosans
    }{%
      \oritone@fontwarning{roboto.sty}{PTSans}%
      \oritone@usepdfsansfallback
    }%
  \else
    \iforitone@recursivesans\else
      \oritone@usepdfsansfallback
    \fi
  \fi
  % Mono role: Recursive via the load above, or Inconsolata otherwise.
  \iforitone@recursivemono\else
    \oritone@usepdfmonofallback
  \fi
  \renewcommand*\rmdefault{stix2}
\else
  % LuaLaTeX/XeLaTeX branch. fontspec can load installed system fonts and local
  % OpenType files directly, so the code tries the requested names first and
  % then known file-family names before falling back to TeX Live fonts.
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}

  \IfFontExistsTF{\oritonefonts@serif}{%
    \setmainfont{\oritonefonts@serif}
  }{%
    \IfFontExistsTF{STIXTwoText-Regular.otf}{%
      \oritone@fontwarning{\oritonefonts@serif}{STIXTwoText OpenType files}%
      \setmainfont{STIXTwoText}[
        Extension=.otf,
        UprightFont=*-Regular,
        ItalicFont=*-Italic,
        BoldFont=*-Bold,
        BoldItalicFont=*-BoldItalic
      ]%
    }{%
      \oritone@fontwarning{\oritonefonts@serif}{TeX Gyre Termes}%
      \setmainfont{TeX Gyre Termes}%
    }%
  }%

  \oritone@fontselectedfalse
  \edef\oritone@requestedfont{\oritonefonts@sans}%
  \ifx\oritone@requestedfont\oritone@roboto@sans
    \oritone@trysetsansfont{Roboto Condensed}%
    \oritone@trysetsansfontfiles{RobotoCondensed}{.otf}%
    \oritone@trysetsansfontfiles{RobotoCondensed}{.ttf}%
    \oritone@trysetsansfont{\oritonefonts@sans}%
  \else
    \ifx\oritone@requestedfont\oritone@recursive@sans
      \oritone@trysetsansfont{Recursive Sans Linear Static}%
      \oritone@trysetsansfont{Recursive Sn Lnr St}%
      \oritone@trysetsansfontfiles{RecursiveSansLnrSt}{.otf}%
      \oritone@trysetsansfontfiles{RecursiveSansLnrSt}{.ttf}%
      \oritone@trysetsansfont{Recursive Sans Casual Static}%
      \oritone@trysetsansfont{Recursive Sn Csl St}%
      \oritone@trysetsansfont{\oritonefonts@sans}%
    \else
      \oritone@trysetsansfont{\oritonefonts@sans}%
    \fi
  \fi
  \iforitone@fontselected\else
    \IfFontExistsTF{PTSans-Regular-tlf-t1.tfm}{%
      \oritone@fontwarning{\oritonefonts@sans}{PTSans package}%
      \RequirePackage[scaled=\oritonefonts@sansscale]{PTSans}%
    }{%
      \oritone@fontwarning{\oritonefonts@sans}{Latin Modern Sans}%
      \setsansfont{Latin Modern Sans}[Scale=\oritonefonts@sansscale]%
    }%
  \fi

  \oritone@fontselectedfalse
  \edef\oritone@requestedfont{\oritonefonts@mono}%
  \ifx\oritone@requestedfont\oritone@recursive@mono
    \oritone@trysetmonofont{Recursive Mono Linear Static}%
    \oritone@trysetmonofont{Recursive Mn Lnr St}%
    \oritone@trysetmonofontfiles{RecursiveMonoLnrSt}{.otf}%
    \oritone@trysetmonofontfiles{RecursiveMonoLnrSt}{.ttf}%
    \oritone@trysetmonofont{Recursive Mono Casual Static}%
    \oritone@trysetmonofont{Recursive Mn Csl St}%
    \oritone@trysetmonofont{\oritonefonts@mono}%
  \else
    \oritone@trysetmonofont{\oritonefonts@mono}%
  \fi
  \iforitone@fontselected\else
    \IfFontExistsTF{Inconsolatazi4-Regular.otf}{%
      \oritone@fontwarning{\oritonefonts@mono}{Inconsolatazi4 OpenType files}%
      \setmonofont{Inconsolatazi4}[
        Extension=.otf,
        UprightFont=*-Regular,
        BoldFont=*-Bold,
        ItalicFont=*-Regular,
        BoldItalicFont=*-Bold,
        Scale=\oritonefonts@monoscale
      ]%
    }{%
      \oritone@fontwarning{\oritonefonts@mono}{Latin Modern Mono}%
      \setmonofont{Latin Modern Mono}[Scale=\oritonefonts@monoscale]%
    }%
  \fi

  % Math is handled after text fonts. unicode-math needs amsmath available, and
  % STIX Two Math keeps the visual language aligned with the default serif.
  \@ifpackageloaded{amsmath}{}{\RequirePackage{amsmath}}%
  \RequirePackage{unicode-math}
  \IfFontExistsTF{\oritonefonts@math}{%
    \setmathfont{\oritonefonts@math}
  }{%
    \IfFontExistsTF{STIXTwoMath-Regular.otf}{%
      \oritone@fontwarning{\oritonefonts@math}{STIXTwoMath OpenType file}%
      \setmathfont{STIXTwoMath-Regular.otf}%
    }{%
      \oritone@fontwarning{\oritonefonts@math}{Latin Modern Math}%
      \setmathfont{Latin Modern Math}%
    }%
  }%
\fi

% Placeholder for future named font profiles. It currently warns instead of
% silently doing nothing so users can spot unsupported configuration requests.
\newcommand*\oritoneusefontprofile[1]{%
  \PackageWarning{oritone-fonts}{Font profile '#1' is not defined in this release}%
}

\endinput
